# Copia este archivo a ".env" y ajusta si lo necesitas.
# NUNCA subas el archivo ".env" real a Git (ya está en .gitignore).

# --- PostgreSQL (metadata de Airflow + base analitica) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
ANALYTICS_DB=gemelo_gold

# --- Airflow ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
# Genera una con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# --- MinIO (almacenamiento tipo S3 simulado) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
