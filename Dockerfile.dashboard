# Imagen liviana para el Panel Operativo (Streamlit) — Fase 3 / Semana 12.
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir streamlit==1.63.0 pandas pyarrow

COPY src /app/src

EXPOSE 8501

ENTRYPOINT ["streamlit", "run", "src/dashboard/operativo.py", \
    "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
