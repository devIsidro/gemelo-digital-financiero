# Imagen liviana para el Panel Operativo (Streamlit) — Fase 3 / Semana 12.
# Diseño según la Guía de Estilo de BBVA (ver src/dashboard/estilo.py).
FROM python:3.11-slim

WORKDIR /app

# psycopg2-binary: leer el historial de corridas de la base de Airflow.
# tzdata: mostrar las horas en America/Mexico_City.
RUN pip install --no-cache-dir streamlit==1.63.0 pandas pyarrow \
    psycopg2-binary==2.9.10 tzdata

COPY src /app/src

EXPOSE 8501

ENTRYPOINT ["streamlit", "run", "src/dashboard/operativo.py", \
    "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", \
    "--theme.base=light", "--theme.primaryColor=#001391", \
    "--theme.backgroundColor=#F7F8F8", "--browser.gatherUsageStats=false"]
